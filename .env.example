# Neo4j — Choose one:

# Option A: Docker local (run docker-compose up -d)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme-local-password
NEO4J_DATABASE=neo4j

# Option B: AuraDB Free (create at https://neo4j.com/cloud/aura-free/)
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-auradb-password
# NEO4J_DATABASE=neo4j

# Google AI Studio — Get your free key at https://aistudio.google.com/apikey
GCP_API_KEY=your-google-ai-studio-key

# The API's bearer token. The API refuses to start without it: an empty key used to authorize
# every request that carried no header.
API_KEY=your-medgraph-api-key
ENVIRONMENT=development

# Optional: Only needed for entity extraction and intelligent router
# Requires a Google Cloud Platform project with Vertex AI enabled
# GCP_PROJECT=your-gcp-project
# GCP_LOCATION=global        # gemini-embedding-2 lives in `global`, not in a region

# --- API only ------------------------------------------------------------------------------
# The active domain profile: profiles/<name>.yaml. It drives what the API publishes in
# GET /admin/v1/descriptor (domain, entity and relation vocabulary) and what the pipeline uses
# to parse and chunk. Ships: medicina (default), generico.
# PROFILE=medicina
#
# How this instance introduces itself in the admin/v1 descriptor. Set them if you run more than
# one engine against the same admin console, so they are told apart.
# INSTANCE_NAME=medgraph-engine          # ^[a-z][a-z0-9-]*$ — the API refuses to start otherwise
# INSTANCE_DISPLAY_NAME=MedGraph Engine
# INSTANCE_VERSION=                      # your build/revision; shown in /admin/v1/health
#
# Public base of this API (descriptor.instance.api_base and the OpenAPI `servers` entry).
# PUBLIC_BASE_URL=http://localhost:8000
#
# Browser origins allowed to call the API, comma-separated. NEVER "*".
# CORS_ORIGINS=http://localhost:3000
#
# Hosts the MCP endpoint (POST /mcp) accepts in the `Host` header. The MCP SDK validates it as
# DNS-rebinding protection and answers `421 Invalid Host header` for anything else. Left empty they
# are derived from PUBLIC_BASE_URL plus localhost; set it when a proxy rewrites the Host or when the
# service answers on more than one domain.
# MCP_ALLOWED_HOSTS=your-host.example.com,localhost:8000
